DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=xuzhihui-resume.com,www.xuzhihui-resume.com,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://xuzhihui-resume.com,https://www.xuzhihui-resume.com

# Database mode: sqlite or postgres
DB_ENGINE=postgres
POSTGRES_DB=xu_portfolio
POSTGRES_USER=xu_portfolio
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=600

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# Optional: override secure defaults
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True
